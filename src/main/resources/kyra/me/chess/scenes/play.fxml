<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<BorderPane style="-fx-background-color: #110e0c;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kyra.me.chess.scripts.controllers.PlayController">
    <!-- Header -->
    <top>
        <VBox alignment="CENTER" spacing="4.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" top="25.0" />
            </padding>
            <children>
                <Label text="MATCH SETUP" textFill="#c9a84c">
                    <font>
                        <Font name="Georgia Bold" size="28.0" />
                    </font>
                </Label>
                <Label text="SELECT PLAYER PROFILES TO BEGIN" textFill="#7a5c2e">
                    <font>
                        <Font name="Segoe UI Bold" size="11.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </top>

    <!-- Left Selection Column (Player 1) -->
    <left>
        <VBox spacing="10.0" style="-fx-background-color: #16120f; -fx-border-color: #7a5c2e; -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <Label text="PLAYER 1 (WHITE)" textFill="#c9a84c">
                    <font>
                        <Font name="Segoe UI Bold" size="12.0" />
                    </font>
                </Label>
                <ScrollPane fitToWidth="true" prefWidth="180.0" style="-fx-background-color: transparent; -fx-background: #16120f; -fx-border-color: transparent;">
                    <content>
                        <VBox fx:id="profileList1" spacing="10.0" style="-fx-background-color: #16120f;" />
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </left>

    <!-- Center Matchup Panel -->
    <center>
        <VBox alignment="CENTER" spacing="30.0" style="-fx-padding: 20;" BorderPane.alignment="CENTER">
            <children>
                <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" spacing="25.0"
                      style="-fx-background-color: #1a1210; -fx-border-color: #7a5c2e; -fx-border-width: 1.5; -fx-background-radius: 12; -fx-border-radius: 12;">
                    <padding>
                        <Insets bottom="35.0" left="40.0" right="40.0" top="35.0" />
                    </padding>
                    <effect>
                        <DropShadow radius="24.0" spread="0.1" offsetY="6.0">
                            <color>
                                <Color red="0.0" green="0.0" blue="0.0" opacity="0.8" />
                            </color>
                        </DropShadow>
                    </effect>
                    <children>
                        <HBox alignment="CENTER" spacing="30.0">
                            <children>
                                <!-- Player 1 Slot -->
                                <VBox alignment="CENTER" spacing="12.0">
                                    <children>
                                        <VBox alignment="CENTER" style="-fx-border-color: #7a5c2e; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-color: #110e0c; -fx-background-radius: 8; -fx-padding: 6;">
                                            <children>
                                                <ImageView fx:id="selectedProfileImage1" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" />
                                            </children>
                                        </VBox>
                                        <Label fx:id="selectedProfileName1" text="Select Player 1" textFill="#c9a84c">
                                            <font>
                                                <Font name="Segoe UI Bold" size="15.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>

                                <!-- VS Badge -->
                                <Label text="VS" textFill="#7a5c2e">
                                    <font>
                                        <Font name="Georgia Bold Italic" size="26.0" />
                                    </font>
                                </Label>

                                <!-- Player 2 Slot -->
                                <VBox alignment="CENTER" spacing="12.0">
                                    <children>
                                        <VBox alignment="CENTER" style="-fx-border-color: #7a5c2e; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-color: #110e0c; -fx-background-radius: 8; -fx-padding: 6;">
                                            <children>
                                                <ImageView fx:id="selectedProfileImage2" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" />
                                            </children>
                                        </VBox>
                                        <Label fx:id="selectedProfileName2" text="Select Player 2" textFill="#c9a84c">
                                            <font>
                                                <Font name="Segoe UI Bold" size="15.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- Start Game Button -->
                        <Button fx:id="startGameButton" mnemonicParsing="false" onAction="#onStartButtonClicked" prefWidth="220.0"
                                style="-fx-background-color: #261e19; -fx-text-fill: #c9a84c; -fx-border-color: #7a5c2e; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;"
                                text="START GAME">
                            <font>
                                <Font name="Segoe UI Bold" size="16.0" />
                            </font>
                            <padding>
                                <Insets bottom="10.0" top="10.0" />
                            </padding>
                        </Button>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>

    <!-- Right Selection Column (Player 2) -->
    <right>
        <VBox spacing="10.0" style="-fx-background-color: #16120f; -fx-border-color: #7a5c2e; -fx-border-width: 0 0 0 1;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <Label text="PLAYER 2 (BLACK)" textFill="#c9a84c">
                    <font>
                        <Font name="Segoe UI Bold" size="12.0" />
                    </font>
                </Label>
                <ScrollPane fitToWidth="true" prefWidth="180.0" style="-fx-background-color: transparent; -fx-background: #16120f; -fx-border-color: transparent;">
                    <content>
                        <VBox fx:id="profileList2" spacing="10.0" style="-fx-background-color: #16120f;" />
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </right>
</BorderPane>
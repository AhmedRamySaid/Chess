<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<Scene fx:id="MainMenuScene" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kyra.me.chess.scripts.controllers.MainMenuController">
    <root>
        <!-- Main Deep Espresso Background -->
        <StackPane style="-fx-background-color: #110e0c;">
            <children>
                <!-- Central Wooden/Gold Menu Card -->
                <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" spacing="22.0"
                      style="-fx-background-color: #1a1210; -fx-border-color: #7a5c2e; -fx-border-width: 1.5; -fx-background-radius: 12; -fx-border-radius: 12;">
                    <padding>
                        <Insets bottom="45.0" left="55.0" right="55.0" top="40.0" />
                    </padding>

                    <effect>
                        <DropShadow radius="28.0" spread="0.12" offsetY="8.0">
                            <color>
                                <Color red="0.0" green="0.0" blue="0.0" opacity="0.85" />
                            </color>
                        </DropShadow>
                    </effect>

                    <children>
                        <!-- Title Block -->
                        <VBox alignment="CENTER" spacing="4.0">
                            <children>
                                <Label text="C H E S S" textFill="#c9a84c">
                                    <font>
                                        <Font name="Georgia Bold" size="38.0" />
                                    </font>
                                </Label>
                                <Label text="A GAME OF STRATEGY" textFill="#7a5c2e">
                                    <font>
                                        <Font name="Segoe UI Bold" size="11.0" />
                                    </font>
                                </Label>
                            </children>
                            <VBox.margin>
                                <Insets bottom="10.0" />
                            </VBox.margin>
                        </VBox>

                        <!-- Play Button -->
                        <Button mnemonicParsing="false" onAction="#onPlayButtonClicked" prefWidth="200.0"
                                style="-fx-background-color: #261e19; -fx-text-fill: #c9a84c; -fx-border-color: #7a5c2e; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;"
                                text="PLAY">
                            <font>
                                <Font name="Segoe UI Bold" size="16.0" />
                            </font>
                            <padding>
                                <Insets bottom="10.0" top="10.0" />
                            </padding>
                        </Button>

                        <!-- Settings Button -->
                        <Button mnemonicParsing="false" onAction="#onSettingsButtonClicked" prefWidth="200.0"
                                style="-fx-background-color: #261e19; -fx-text-fill: #c9a84c; -fx-border-color: #7a5c2e; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;"
                                text="SETTINGS">
                            <font>
                                <Font name="Segoe UI Bold" size="16.0" />
                            </font>
                            <padding>
                                <Insets bottom="10.0" top="10.0" />
                            </padding>
                        </Button>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </root>
</Scene>